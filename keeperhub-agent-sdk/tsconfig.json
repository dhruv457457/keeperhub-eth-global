{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@local/keeperhub-sdk": ["../packages/sdk/dist/index.d.ts"],
      "@local/keeperhub-langchain": [
        "../packages/langchain-tools/dist/index.d.ts"
      ],
      "@local/keeperhub-elizaos": ["../packages/elizaos-plugin/dist/index.d.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-showcase/types/**/*.ts",
    ".next-showcase/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "examples"]
}
