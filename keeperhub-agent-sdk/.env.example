KEEPERHUB_API_KEY=kh_your_key_here
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_WALLET=0xYourWallet

# Live-safe default. Set true only when you intentionally want tiny Sepolia writes.
ENABLE_SEPOLIA_WRITES=false
TEST_NETWORK=11155111
TEST_RECIPIENT=0xYourWallet
TEST_AMOUNT=0.0001

# Optional future full payment settlement. Without a signer, paid demos stop at
# the real x402/MPP challenge.
KEEPERHUB_PAYMENT_SIGNER=
